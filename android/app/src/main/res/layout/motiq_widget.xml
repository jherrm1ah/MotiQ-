<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/motiq_widget_bg"
    android:orientation="vertical"
    android:padding="14dp">

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
        <TextView android:id="@+id/widget_car" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:text="Motiq" android:textColor="#FFFFFF" android:textSize="15sp" android:textStyle="bold" android:maxLines="1" android:ellipsize="end" />
        <TextView android:id="@+id/widget_health" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:textColor="#EFFF00" android:textSize="15sp" android:textStyle="bold" />
    </LinearLayout>

    <TextView android:id="@+id/widget_due" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp"
        android:textColor="#BDBDBD" android:textSize="12sp" android:maxLines="1" android:ellipsize="end" />
    <TextView android:id="@+id/widget_extra" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="2dp"
        android:textColor="#BDBDBD" android:textSize="12sp" android:maxLines="1" android:ellipsize="end" />

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:orientation="horizontal">
        <TextView android:id="@+id/widget_trip" android:layout_width="0dp" android:layout_height="36dp" android:layout_weight="1"
            android:background="@drawable/motiq_widget_button" android:gravity="center" android:text="Start trip"
            android:textColor="#000000" android:textSize="13sp" android:textStyle="bold" />
        <TextView android:id="@+id/widget_sos" android:layout_width="64dp" android:layout_height="36dp" android:layout_marginStart="8dp"
            android:background="@drawable/motiq_widget_sos" android:gravity="center" android:text="SOS"
            android:textColor="#FFFFFF" android:textSize="13sp" android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
